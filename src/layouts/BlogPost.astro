---
import BaseHead from "../components/BaseHead.astro";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ReaderSidebar from "../components/blog/ReaderSidebar.astro";
import Faq from "../components/blog/Faq.astro";
import { getPublishedPosts, readingTime } from "../utils/blog";
import type { MarkdownHeading } from "astro";
import Breadcrumbs from "../components/ui/Breadcrumbs.astro";
import ContentTranslation from "../components/ContentTranslation.astro";

interface Props {
  post: CollectionEntry<"blog">;
  headings: MarkdownHeading[];
}

const { post, headings } = Astro.props;
const { title, description, lang, pubDate, updatedDate, tags = [] } = post.data;
const faq = post.data.faq;
const estTime = readingTime(post.body);
const tableOfContents = headings.filter((heading) => heading.depth === 2);
const relatedPosts = (await getPublishedPosts())
  .filter((entry) => entry.id !== post.id)
  .map((entry) => ({
    post: entry,
    sharedTags: (entry.data.tags ?? []).filter((tag) => tags.includes(tag)).length,
  }))
  .filter((entry) => entry.sharedTags > 0)
  .sort((a, b) => b.sharedTags - a.sharedTags || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3);

const rawMarkdown = `---
title: "${title.replace(/"/g, '\\"')}"
description: "${(description || '').replace(/"/g, '\\"')}"
pubDate: "${pubDate.toISOString().split("T")[0]}"
tags: [${tags.map((t: string) => `"${t}"`).join(", ")}]
---

${post.body ?? ""}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead
      title={`${title} · Matías Blanc`}
      pageTitle={title}
      description={description}
      image={post.data.image}
      imageAlt={post.data.imageAlt ?? undefined}
      lang={lang}
      type="article"
      pubDate={pubDate}
      updatedDate={updatedDate}
      tags={tags}
      faq={faq}
    />
  </head>
  <body class="bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    <!-- Reading Progress Bar (Fixed Top) -->
    <div
      id="reading-progress"
      class="fixed top-0 left-0 right-0 h-[2.5px] bg-primary z-50 origin-left scale-x-0 transition-transform duration-75"
      aria-hidden="true"
    ></div>

    <Header />

    <!-- Article layout container with Reader Sidebar placed snugly on the left -->
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6">
      <!-- Modular Vertical Reader Sidebar Dock -->
      <ReaderSidebar
        title={title}
        slug={post.id}
        rawMarkdown={rawMarkdown}
      />

      <main class="max-w-2xl mx-auto py-6 sm:py-12">
        <Breadcrumbs section="blog" title={title} />
        <!-- Back link -->
        <div class="mb-6 pb-3 sm:mb-10 sm:pb-4 border-b border-border text-xs">
          <a
            href="/blog"
            class="inline-flex items-center gap-1.5 font-medium text-muted hover:text-foreground transition-colors group"
          >
            <span class="group-hover:-translate-x-1 transition-transform">←</span>
            <span data-lang-en>All articles</span>
            <span data-lang-es>Todos los artículos</span>
          </a>
        </div>

        <!-- Article Header -->
        <header class="mb-8 pb-6 sm:mb-12 sm:pb-8 border-b border-border">
          <p class="text-sm text-muted mb-3">
            Por <a href="/#about" rel="author" class="text-primary hover:underline">Matías Blanc</a>
          </p>
          <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-muted mb-3 sm:mb-4">
            <FormattedDate date={pubDate} />
            {estTime && <span>· {estTime} min de lectura</span>}
            {updatedDate && (
              <span>
                (Actualizado: <FormattedDate date={updatedDate} />)
              </span>
            )}
          </div>

          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground leading-[1.15] mb-3 sm:mb-6">
            {title}
          </h1>

          {description && (
            <p class="text-sm sm:text-lg text-muted leading-relaxed mb-4 sm:mb-6 font-sans">
              {description}
            </p>
          )}

          {tags.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-1 sm:pt-2">
              {tags.map((tag) => (
                <span class="text-xs font-mono text-muted">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </header>

        {tableOfContents.length > 1 && (
          <nav aria-labelledby="article-toc" class="mb-8 rounded-2xl border border-border bg-background-card p-5">
            <h2 id="article-toc" class="font-semibold text-foreground mb-3">En este artículo</h2>
            <ol class="space-y-2 text-sm leading-relaxed">
              {tableOfContents.map((heading) => (
                <li><a href={`#${heading.slug}`} class="text-primary hover:underline">{heading.text}</a></li>
              ))}
            </ol>
          </nav>
        )}

        <!-- Markdown Article Content (Styled with @tailwindcss/typography with high contrast) -->
        <article
          id="article-content"
          class="reader-content prose dark:prose-invert max-w-none
            prose-headings:tracking-tight prose-headings:font-bold prose-headings:text-foreground
            prose-h2:text-xl sm:prose-h2:text-3xl
            prose-h2:mt-10 sm:prose-h2:mt-14 prose-h2:mb-4 sm:prose-h2:mb-5
            prose-h2:border-b prose-h2:border-border prose-h2:pb-2 sm:prose-h2:pb-3
            prose-h3:text-lg sm:prose-h3:text-2xl prose-h3:mt-8 sm:prose-h3:mt-10 prose-h3:mb-3 sm:prose-h3:mb-4
            prose-p:text-muted prose-p:mb-5 sm:prose-p:mb-6
            prose-li:text-muted prose-li:my-1 sm:prose-li:my-1.5
            prose-strong:text-foreground prose-strong:font-semibold
            prose-a:text-primary prose-a:underline prose-a:underline-offset-4 prose-a:hover:text-primary-hover
            prose-code:font-mono prose-code:text-primary prose-code:bg-primary-subtle
            prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-[0.9em]
            prose-pre:border prose-pre:border-border prose-pre:bg-background-card prose-pre:rounded-2xl prose-pre:p-4 sm:prose-pre:p-5
            prose-blockquote:border-l-2 prose-blockquote:border-primary prose-blockquote:bg-background-surface
            prose-blockquote:text-foreground prose-blockquote:py-2.5 sm:prose-blockquote:py-3 prose-blockquote:px-4 sm:prose-blockquote:px-5 prose-blockquote:not-italic
            prose-blockquote:rounded-r-xl prose-blockquote:my-6 sm:prose-blockquote:my-8
            prose-hr:border-border prose-hr:my-8 sm:prose-hr:my-12
            prose-img:rounded-2xl prose-img:border prose-img:border-border prose-img:my-6 sm:prose-img:my-8"
        >
          <slot />

          {faq && faq.length > 0 && (
            <Faq
              items={faq}
              title="Preguntas Frecuentes"
              lang="es"
            />
          )}
        </article>

        <aside aria-labelledby="article-author" class="mt-10 border-t border-border pt-6 text-sm text-muted leading-relaxed">
          <h2 id="article-author" class="font-semibold text-foreground mb-2">Sobre el autor</h2>
          <p>
            Soy <a href="/#about" rel="author" class="text-primary hover:underline">Matías Blanc</a>,
            desarrollador full-stack en Coquimbo, Chile, y estudiante de Ingeniería Civil en Computación en la UCN.
            Documento las decisiones y limitaciones de <a href="/projects" class="text-primary hover:underline">mis proyectos</a>.
          </p>
        </aside>

        {relatedPosts.length > 0 && (
          <nav aria-labelledby="related-posts" class="mt-8 border-t border-border pt-6">
            <h2 id="related-posts" class="text-lg font-semibold text-foreground mb-4">Artículos relacionados</h2>
            <ul class="space-y-4">
              {relatedPosts.map(({ post: related }) => (
                <li>
                  <a href={`/blog/${related.id}`} class="text-primary font-medium hover:underline">{related.data.title}</a>
                  <p class="text-sm text-muted mt-1">{related.data.description}</p>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <!-- Footer navigation -->
        <div class="mt-10 sm:mt-16 pt-6 sm:pt-8 border-t border-border flex items-center justify-between gap-4 text-xs sm:text-sm font-mono">
          <a
            href="/blog"
            class="text-muted hover:text-foreground transition-colors flex items-center gap-1.5 group"
          >
            <span class="group-hover:-translate-x-1 transition-transform">←</span>
            <span data-lang-en>Back to articles</span>
            <span data-lang-es>Volver al blog</span>
          </a>
          <a
            href="mailto:hi@matiasblanc.dev"
            class="text-xs font-semibold text-primary hover:underline transition-colors"
          >
            hi@matiasblanc.dev →
          </a>
        </div>
      </main>
    </div>

    <Footer />
    <ContentTranslation />

    <!-- Reading Progress Bar Logic -->
    <script>
      const progressBar = document.getElementById("reading-progress");
      function updateReadingProgress() {
        const article = document.getElementById("article-content");
        if (!article || !progressBar) return;
        const totalHeight = article.clientHeight;
        const articleTop = article.offsetTop;
        const scrollY = window.scrollY;
        const windowHeight = window.innerHeight;

        const progress = Math.min(
          Math.max((scrollY - articleTop + 200) / (totalHeight - windowHeight + 300), 0),
          1
        );
        progressBar.style.transform = `scaleX(${progress})`;
      }
      window.addEventListener("scroll", updateReadingProgress, { passive: true });
      updateReadingProgress();
    </script>
  </body>
</html>
