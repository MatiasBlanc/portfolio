---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ui/ProjectCard.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import "../../global.css";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Projects · ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />
  </head>
  <body class="bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-16">
      <!-- Page header -->
      <div class="mb-6 sm:mb-12">
        <p class="text-xs font-mono font-semibold uppercase tracking-widest text-muted mb-1.5 sm:mb-3">
          Matías Blanc · Portfolio
        </p>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-foreground tracking-tight leading-tight">
          <span data-lang-en>Projects</span>
          <span data-lang-es>Proyectos</span>
        </h1>
      </div>

      <!-- Projects bento grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {projects.map((project) => (
          <ProjectCard
            id={project.id}
            title={project.data.title}
            description={project.data.description}
            image={project.data.image}
            imageAlt={project.data.imageAlt}
            date={project.data.pubDate}
            tags={project.data.tags}
            status={project.data.status}
          />
        ))}
      </div>
    </main>

    <Footer />
  </body>
</html>
