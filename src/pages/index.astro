---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import ConsoleCard from "../components/ui/ConsoleCard.astro";

import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="w-8/12 mx-auto">
    <Header currentPage="inicio" />
    <main class="divide-y divide-foreground">
      <div class="py-5">
        <h1 class="text-sans text-foreground text-5xl font-bold">
          Matias Blanc
        </h1>
      </div>
      <div>
        <ConsoleCard
          title="bio.txt"
          content="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat."
        />
      </div>
      <section class="grid grid-cols-2 divide-x divide-foreground gap-5">
        <ConsoleCard
          title="experiencia.log"
          content="This is a simple console card."
          buttonText="download cv"
        />
        <ConsoleCard
          title="taekwondo.log"
          content="Cinturon negro de Fechitat"
        />
      </section>
    </main>
  </body>
</html>
