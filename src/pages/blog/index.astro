---
import { getCollection } from "astro:content";

import BaseHead from "../../components/BaseHead.astro";
import BlogCard from "../../components/ui/BlogCard.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body
    class="w-full lg:w-9/12 mx-auto bg-background text-foreground font-mono"
  >
    <Header currentPage="blog" />
    <main class="px-4 lg:px-0">
      <section class="divide-y divide-foreground">
        <!-- <h1 class="text-sans text-foreground text-3xl font-bold">blog</h1> -->
        <ul class="lg:w-9/12 flex flex-col p-0 mx-auto">
          {
            posts.map((post) => (
              <BlogCard
                id={post.id}
                title={post.data.title}
                status={post.data.status}
                pubDate={post.data.pubDate}
              />
            ))
          }
        </ul>
      </section>
    </main>
  </body>
</html>
