---
import { getPublishedPosts, readingTime } from "../../utils/blog";

import BaseHead from "../../components/BaseHead.astro";
import BlogCard from "../../components/ui/BlogCard.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/ui/PageHeader.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import "../../global.css";

const posts = (await getPublishedPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Paginación: 6 posts por página vía ?page=N
const PAGE_SIZE = 6;
const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const rawPage = Number(Astro.url.searchParams.get("page")) || 1;
const page = Math.min(Math.max(rawPage, 1), totalPages);
const pagePosts = posts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

// Tags únicos de todos los posts publicados
const allTags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort();
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={`Blog · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body
    class="w-full lg:w-9/12 mx-auto bg-background text-foreground font-mono px-4 lg:px-0"
  >
    <Header currentPage="blog" />
    <main>
      <PageHeader title="Blog" />

      <!-- Buscador + filtro por tags -->
      {
        posts.length > 0 && (
          <div class="mb-6 -mt-2 flex flex-col gap-3 lg:w-9/12 mx-auto">
            <div class="relative">
              <span
                class="absolute left-4 top-1/2 -translate-y-1/2 text-muted text-sm pointer-events-none"
                aria-hidden="true"
              >
                $
              </span>
              <input
                id="blog-search"
                type="search"
                placeholder="grep -i 'título o descripción'"
                aria-label="Buscar artículos"
                class="w-full bg-background-surface border border-foreground/15 rounded-full pl-9 pr-4 py-2.5 font-mono text-sm text-foreground placeholder:text-muted/60 focus:outline-none focus:border-primary transition-colors duration-200"
              />
            </div>

            <div
              id="blog-tags"
              class="flex flex-wrap gap-2"
              role="group"
              aria-label="Filtrar por tags"
            >
              <button
                type="button"
                data-tag="all"
                class="tag-pill tag-pill-active font-mono text-xs px-3 py-1 rounded-full border transition-colors duration-200 cursor-pointer"
              >
                todos
              </button>
              {
                allTags.map((tag) => (
                  <button
                    type="button"
                    data-tag={tag}
                    class="tag-pill font-mono text-xs px-3 py-1 rounded-full border transition-colors duration-200 cursor-pointer"
                  >
                    {tag}
                  </button>
                ))
              }
            </div>
          </div>
        )
      }

      <p class="text-muted text-sm font-mono mb-6 lg:w-9/12 mx-auto">
        <span id="blog-count">
          {`${pagePosts.length} ${pagePosts.length === 1 ? "artículo" : "artículos"} en esta página`}
        </span>
      </p>

      {
        posts.length > 0 ? (
          <>
            <ul id="blog-grid" class="grid grid-cols-1 gap-4 lg:w-9/12 mx-auto">
              {pagePosts.map((post, index) => (
                <li
                  data-post-card
                  data-tags={(post.data.tags ?? []).join(",")}
                  data-title={post.data.title}
                  data-description={post.data.description}
                  class="animate-fade-in"
                  style={`--animation-delay: ${index * 80}ms`}
                >
                  <BlogCard
                    id={post.id}
                    title={post.data.title}
                    description={post.data.description}
                    status={post.data.status}
                    pubDate={post.data.pubDate}
                    tags={post.data.tags}
                    readingTime={readingTime(post.body)}
                  />
                </li>
              ))}
            </ul>

            <div
              id="blog-empty"
              class="hidden text-center py-16 lg:w-9/12 mx-auto"
            >
              <p class="font-mono text-muted text-sm">
                $ grep: no se encontraron resultados
              </p>
              <p class="text-muted/50 text-xs mt-2">
                Prueba con otro término o tag
              </p>
            </div>

            {
              totalPages > 1 && (
                <nav
                  id="blog-pagination"
                  aria-label="Paginación"
                  class="flex items-center justify-center gap-5 mt-10 font-mono text-sm lg:w-9/12 mx-auto"
                >
                  {page > 1 ? (
                    <a
                      href={`/blog/?page=${page - 1}`}
                      class="text-muted hover:text-primary transition-colors duration-200"
                    >
                      « anterior
                    </a>
                  ) : (
                    <span class="text-muted opacity-30 cursor-not-allowed">
                      « anterior
                    </span>
                  )}

                  <span class="text-muted">
                    {page}/{totalPages}
                  </span>

                  {page < totalPages ? (
                    <a
                      href={`/blog/?page=${page + 1}`}
                      class="text-muted hover:text-primary transition-colors duration-200"
                    >
                      siguiente »
                    </a>
                  ) : (
                    <span class="text-muted opacity-30 cursor-not-allowed">
                      siguiente »
                    </span>
                  )}
                </nav>
              )
            }
          </>
        ) : (
          <div class="text-center py-16">
            <p class="font-mono text-muted text-sm">
              $ echo "No hay posts todavía"
            </p>
            <p class="text-muted/50 text-xs mt-2">Próximamente...</p>
          </div>
        )
      }
    </main>

    <Footer />
  </body>
</html>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.5s ease var(--animation-delay, 0ms) both;
    animation-timeline: view();
    animation-range: entry 0% cover 30%;
  }

  /* Pills de tags */
  .tag-pill {
    border-color: var(--color-foreground);
    opacity: 0.25;
    color: var(--color-foreground);
    background: transparent;
  }
  .tag-pill:hover {
    opacity: 0.6;
  }
  .tag-pill-active,
  .tag-pill-active:hover {
    opacity: 1;
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
</style>

<script>
  // Filtrado client-side: búsqueda por texto + tag activo
  const searchInput = document.getElementById("blog-search");
  const tagButtons = document.querySelectorAll("[data-tag]");
  const cards = document.querySelectorAll("[data-post-card]");
  const countEl = document.getElementById("blog-count");
  const emptyEl = document.getElementById("blog-empty");
  const gridEl = document.getElementById("blog-grid");
  const paginationEl = document.getElementById("blog-pagination");

  let activeTag = "all";

  function applyFilter() {
    const query = searchInput ? searchInput.value.trim().toLowerCase() : "";
    const hasFilter = activeTag !== "all" || query !== "";
    let visible = 0;

    cards.forEach((card) => {
      const tags = (card.dataset.tags ?? "").split(",").filter(Boolean);
      const haystack =
        `${card.dataset.title ?? ""} ${card.dataset.description ?? ""}`.toLowerCase();

      const matchesTag = activeTag === "all" || tags.includes(activeTag);
      const matchesQuery = !query || haystack.includes(query);
      const show = matchesTag && matchesQuery;

      card.classList.toggle("hidden", !show);
      if (show) visible++;
    });

    countEl.textContent = `${visible} ${visible === 1 ? "artículo" : "artículos"}${hasFilter ? " encontrados" : " en esta página"}`;
    emptyEl.classList.toggle("hidden", visible > 0);
    gridEl.classList.toggle("hidden", visible === 0);
    paginationEl?.classList.toggle("hidden", hasFilter);
  }

  tagButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeTag = btn.dataset.tag ?? "all";
      tagButtons.forEach((b) =>
        b.classList.toggle("tag-pill-active", b === btn),
      );
      applyFilter();
    });
  });

  searchInput?.addEventListener("input", applyFilter);
</script>
