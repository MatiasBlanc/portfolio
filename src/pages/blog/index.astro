---
import { getPublishedPosts, readingTime } from "../../utils/blog";
import BaseHead from "../../components/BaseHead.astro";
import BlogCard from "../../components/ui/BlogCard.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import RssButton from "../../components/blog/RssButton.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import "../../global.css";

const posts = (await getPublishedPosts()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Articles & Builds · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
  </head>
  <body class="bg-background text-foreground antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-16">
      <!-- Page header with title and RSS Feed button -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-6 sm:mb-8">
        <div>
          <p class="text-xs font-mono font-semibold uppercase tracking-widest text-muted mb-1.5 sm:mb-3">
            Matías Blanc · Writing
          </p>
          <h1 class="text-3xl sm:text-5xl font-extrabold text-foreground tracking-tight">
            Articles & Builds
          </h1>
        </div>

        <!-- Modular RSS Feed Button -->
        <RssButton />
      </div>

      <!-- Prominent Search Bar (Clean and responsive) -->
      {posts.length > 0 && (
        <div class="mb-6 sm:mb-10 max-w-xl">
          <div class="relative">
            <input
              id="blog-search"
              type="search"
              placeholder="Search articles by title or keyword..."
              aria-label="Search articles"
              class="w-full bg-background-card border border-border rounded-2xl pl-12 pr-5 py-3 sm:py-3.5 text-sm sm:text-base text-foreground placeholder:text-muted focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary/40 transition-all shadow-sm"
            />
            <svg
              class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-muted pointer-events-none"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
          </div>
          <p class="text-xs font-mono text-muted mt-2 sm:mt-3 pl-1">
            <span id="blog-count">{`${posts.length} ${posts.length === 1 ? "article" : "articles"}`}</span>
          </p>
        </div>
      )}

      <!-- Posts grid (Equalized heights and responsive columns) -->
      {posts.length > 0 ? (
        <>
          <div
            id="blog-grid"
            class:list={[
              "grid gap-5 items-stretch",
              posts.length === 2
                ? "grid-cols-1 md:grid-cols-2"
                : "grid-cols-1 md:grid-cols-2 lg:grid-cols-3"
            ]}
          >
            {posts.map((post) => (
              <div
                data-post-card
                data-tags={(post.data.tags ?? []).join(",")}
                data-title={post.data.title}
                data-description={post.data.description}
                class="h-full flex flex-col"
              >
                <BlogCard
                  id={post.id}
                  title={post.data.title}
                  description={post.data.description}
                  status={post.data.status}
                  pubDate={post.data.pubDate}
                  tags={post.data.tags}
                  readingTime={readingTime(post.body)}
                  image={post.data.image}
                  imageAlt={post.data.imageAlt ?? undefined}
                />
              </div>
            ))}
          </div>
          <div id="blog-empty" class="hidden text-center py-12 sm:py-20">
            <p class="text-muted text-base">No articles found matching your search.</p>
          </div>
        </>
      ) : (
        <div class="text-center py-12 sm:py-20">
          <p class="text-muted text-base">No articles published yet.</p>
        </div>
      )}
    </main>

    <Footer />

    <script>
      const searchInput = document.getElementById("blog-search") as HTMLInputElement | null;
      const cards = document.querySelectorAll("[data-post-card]") as NodeListOf<HTMLElement>;
      const countEl = document.getElementById("blog-count");
      const emptyEl = document.getElementById("blog-empty");
      const gridEl = document.getElementById("blog-grid");

      function applyFilter() {
        const query = searchInput?.value.trim().toLowerCase() ?? "";
        let visible = 0;

        cards.forEach((card) => {
          const tags = (card.dataset.tags ?? "").toLowerCase();
          const title = (card.dataset.title ?? "").toLowerCase();
          const desc = (card.dataset.description ?? "").toLowerCase();
          const haystack = `${title} ${desc} ${tags}`;
          const show = !query || haystack.includes(query);

          card.classList.toggle("hidden", !show);
          if (show) visible++;
        });

        if (countEl) countEl.textContent = `${visible} ${visible === 1 ? "article" : "articles"}`;
        emptyEl?.classList.toggle("hidden", visible > 0);
        gridEl?.classList.toggle("hidden", visible === 0);
      }

      searchInput?.addEventListener("input", applyFilter);
    </script>
  </body>
</html>
