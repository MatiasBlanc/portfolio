---
// src/components/FeaturedProjects.astro
// Proyectos destacados — lista estilo terminal, sin imágenes (homepage)

const projects = [
  {
    title: "App ITF — plataforma móvil",
    description:
      "Plataforma móvil para la International Taekwon-Do Federation. Gestión de eventos, torneos y registro de atletas.",
    status: "en_progreso" as const,
    tags: ["React Native", "Python", "ITF"],
    href: "/projects",
  },
  {
    title: "Dotfiles — setup de terminal",
    description:
      "Configuración completa de entorno: Neovim, Kitty, Zsh + Starship. Documentado y reproducible.",
    status: "completado" as const,
    tags: ["Neovim", "Zsh", "Kitty"],
    href: "/projects",
  },
  {
    title: "Portfolio — matiasblanc.dev",
    description:
      "Portfolio personal construido con Astro, TypeScript y TailwindCSS. Estética de terminal.",
    status: "en_progreso" as const,
    tags: ["Astro", "TypeScript", "TailwindCSS"],
    href: "/projects",
  },
] as const;

const statusLabel = {
  en_progreso: "en progreso",
  completado: "completado",
  pausado: "pausado",
} as const;

const statusColor = {
  en_progreso: "bg-primary text-background",
  completado: "bg-foreground text-background",
  pausado: "bg-muted/60 text-foreground",
} as const;
---

<section class="py-5 border-t border-foreground">
  <h3 class="text-muted mb-4 font-mono text-md tracking-tight">
    $ cat proyectos/activo
  </h3>
  <ul class="divide-y divide-foreground">
    {
      projects.map((project) => (
        <li class="list-none group">
          <a
            href={project.href}
            class="flex flex-col md:flex-row md:items-center justify-between gap-3 py-4 px-2 hover:bg-foreground/5 transition-colors duration-200"
          >
            <div>
              <h4 class="font-bold font-sans text-lg group-hover:text-primary transition-colors duration-200">
                {project.title}
              </h4>
              <p class="text-muted text-sm mt-0.5">{project.description}</p>
              <div class="flex gap-2 flex-wrap mt-2">
                {project.tags.map((tag) => (
                  <span class="font-mono text-xs text-muted px-2 py-0.5 border border-foreground/20">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            <span
              class:list={[
                "font-mono text-xs px-3 py-1 shrink-0 font-semibold tracking-tight self-start md:self-center",
                statusColor[project.status],
              ]}
            >
              {statusLabel[project.status]}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
