---

<section class="hero-section min-h-[80vh] flex flex-col justify-center py-16 text-center">
  <div class="relative flex flex-col items-center">
    <!-- Nombre principal -->
    <h1 class="hero-title font-bold leading-[1.05] tracking-tighter text-foreground">
      Matías Blanc
    </h1>

    <!-- Subtítulo con rol -->
    <div class="hero-subtitle mt-5 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-3">
      <span class="font-mono text-primary font-semibold text-sm md:text-base">
        &lt;frontend dev /&gt;
      </span>
      <span class="hidden sm:block text-muted opacity-40">·</span>
      <span class="font-mono text-muted text-sm md:text-base">
        Cinturón negro de Taekwon-Do ITF
      </span>
    </div>

    <!-- CTA / Links sociales -->
    <div class="hero-cta mt-10 flex flex-wrap justify-center gap-3">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 bg-primary text-background px-5 py-2.5 font-mono text-sm font-semibold tracking-tight rounded-full hover:bg-primary-hover transition-colors duration-200"
      >
        ver proyectos
      </a>
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 border border-foreground/20 text-foreground px-5 py-2.5 font-mono text-sm tracking-tight rounded-full hover:bg-foreground/5 transition-colors duration-200"
      >
        contactar
      </a>
    </div>
  </div>
</section>

<style>
  /* Tamaño fluido del título */
  .hero-title {
    font-size: clamp(3rem, 8vw, 6rem);
    font-family: var(--font-sans);
  }
</style>
