---
// src/components/Footer.astro
import socials from "../data/socials.json";
---

<footer class="w-full border-t border-border mt-10 sm:mt-20 py-6 sm:py-10 text-sm">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-center">
    <!-- Social links -->
    <ul class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 list-none">
      <li>
        <a
          href={socials.upwork.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-medium text-muted hover:text-foreground transition-colors"
        >
          UpWork
        </a>
      </li>
      <li>
        <a
          href={socials.github.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-medium text-muted hover:text-foreground transition-colors"
        >
          GitHub
        </a>
      </li>
      <li>
        <a
          href={socials.linkedin.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-medium text-muted hover:text-foreground transition-colors"
        >
          LinkedIn
        </a>
      </li>
      <li>
        <a
          href={socials.twitter.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-medium text-muted hover:text-foreground transition-colors"
        >
          Twitter / X
        </a>
      </li>
    </ul>
  </div>
</footer>
