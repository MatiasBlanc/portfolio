---
import FormattedDate from "../../components/FormattedDate.astro";

interface Props {
  id: string;
  title: string;
  status: string;
  pubDate: Date;
}
const { id, title, status, pubDate } = Astro.props;
---

<li class="list-none border-b border-foreground last:border-b-0">
  <a
    class="flex flex-col md:flex-row md:items-center justify-between gap-2 py-4 px-2 hover:bg-foreground/5 duration-300 cursor-pointer"
    href={`/blog/${id}/`}
  >
    <div class="flex flex-col gap-1 lg:flex-row lg:gap-8 items-center">
      <p class="text-muted text-sm font-mono tracking-tight">
        <FormattedDate date={pubDate} />
      </p>
      <h4 class="font-bold text-lg font-sans">{title}</h4>
    </div>

    <p class="text-muted text-sm font-mono">
      [ {status} ]
    </p>
  </a>
</li>
