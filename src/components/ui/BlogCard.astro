---
/**
 * Card de blog reutilizable.
 * Muestra vista previa de un post con fecha, título, descripción y estado.
 *
 * @example
 * <BlogCard id="mi-post" title="Mi Post" status="build" pubDate={new Date()} />
 * <BlogCard id="mi-post" title="Mi Post" description="Descripción" status="build" pubDate={new Date()} />
 */

import FormattedDate from "../FormattedDate.astro";
import Card from "./Card.astro";
import Tag from "./Tag.astro";

interface Props {
  /** ID del post (slug) */
  id: string;
  /** Título del post */
  title: string;
  /** Descripción breve (opcional) */
  description?: string;
  /** Estado del post */
  status: string;
  /** Fecha de publicación */
  pubDate: Date;
  /** Tags/categorías del post */
  tags?: string[];
  /** Tiempo de lectura estimado en minutos */
  readingTime?: number;
}

const { id, title, description, status, pubDate, tags = [], readingTime } = Astro.props;

/** Colores por status conocidos */
const statusColors: Record<string, string> = {
  build: "bg-primary/20 text-primary",
  post: "bg-foreground/10 text-foreground",
  draft: "bg-muted/30 text-muted",
  published: "bg-foreground/10 text-foreground",
};

const statusColor = statusColors[status] || "bg-muted/20 text-muted";
---

<Card as="li" href={`/blog/${id}/`} padding="sm">
  <div class="group flex flex-col gap-2">
    <div class="flex items-center justify-between gap-3">
      <p class="text-muted text-xs font-mono tracking-tight">
        <FormattedDate date={pubDate} />
        {readingTime && ` · ${readingTime} min`}
      </p>
      <span
        class:list={[
          "text-[10px] font-mono font-semibold tracking-wider uppercase px-2.5 py-0.5 rounded-full",
          statusColor,
        ]}
      >
        {status}
      </span>
    </div>
    <h4
      class="font-bold text-xl font-sans text-foreground group-hover:text-primary transition-colors duration-200 leading-tight"
    >
      {title}
    </h4>
    {
      description && (
        <p class="text-muted text-sm leading-relaxed line-clamp-2">
          {description}
        </p>
      )
    }
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
          {tags.map((tag) => <Tag text={tag} />)}
        </div>
      )
    }
  </div>
</Card>
