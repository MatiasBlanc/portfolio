---
/**
 * BlogCard — bento-style tile with bottom-to-top gradient overlay.
 * Clean, high-contrast monochrome design without bulky background boxes on dates.
 * Entire card is a clickable link to the article.
 */

import FormattedDate from "../FormattedDate.astro";

interface Props {
  id: string;
  title: string;
  description?: string;
  status?: string;
  pubDate: Date;
  tags?: string[];
  readingTime?: number;
  image?: string;
  imageAlt?: string;
  featured?: boolean;
}

const {
  id,
  title,
  description,
  pubDate,
  tags = [],
  readingTime,
  image,
  imageAlt,
  featured = false,
} = Astro.props;

const displayTags = tags.slice(0, 2);
---

<a
  href={`/blog/${id}/`}
  class="group relative flex flex-col justify-between rounded-3xl border border-border bg-background-card hover:border-border-hover transition-all duration-200 overflow-hidden min-h-[250px] h-full p-6 sm:p-7 block cursor-pointer select-none shadow-sm hover:shadow-md"
  aria-label={`Read article: ${title}`}
>
  {/* Full-cover image with bottom-up theme-adaptive gradient */}
  {image ? (
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden bg-background-subtle">
      <img
        src={image}
        alt={imageAlt || title}
        class="w-full h-full object-cover object-top opacity-60 group-hover:opacity-85 group-hover:scale-105 transition-all duration-500"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-background-card via-background-card/85 to-transparent" />
      <div class="absolute inset-0 bg-gradient-to-t from-background-card/95 via-background-card/40 to-transparent" />
    </div>
  ) : (
    <div class="absolute inset-0 z-0 bg-gradient-to-br from-background-subtle to-background-card pointer-events-none" />
  )}

  {/* Top meta: clean typography without background box */}
  <div class="relative z-10 flex items-center justify-between gap-2 text-xs font-mono text-muted pointer-events-none">
    <div class="flex items-center gap-1.5 text-xs text-muted">
      <FormattedDate date={pubDate} />
      {readingTime && <span>· {readingTime} min read</span>}
    </div>
  </div>

  {/* Bottom content */}
  <div class="relative z-10 flex flex-col gap-2.5 mt-auto pointer-events-none">
    <h3 class:list={[
      "font-bold text-foreground group-hover:text-primary transition-colors duration-200 leading-snug",
      featured ? "text-2xl sm:text-3xl md:text-4xl max-w-xl" : "text-lg sm:text-xl"
    ]}>
      {title}
    </h3>

    {featured && description && (
      <p class="text-sm text-muted line-clamp-2 max-w-lg leading-relaxed">
        {description}
      </p>
    )}

    {displayTags.length > 0 && (
      <div class="flex flex-wrap gap-2 pt-1">
        {displayTags.map((tag) => (
          <span class="text-[11px] font-mono text-muted/70">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
