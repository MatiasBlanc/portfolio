---
interface Props {
  href: string;
  label: string;
  isActive: boolean;
}

const { href, label, isActive } = Astro.props;
---

<li
  class:list={[
    "rounded-full transition-colors",
    isActive
      ? "bg-primary/10 text-primary"
      : "hover:bg-foreground/5 text-foreground hover:text-primary-hover",
  ]}
>
  <a href={href} class="block px-4 py-1.5 text-sm font-medium">
    {label}
  </a>
</li>
