---
/**
 * ProjectCard — Modern project showcase card.
 * Dedicated visual screenshot on top with smooth opacity + clean metadata below.
 * Entire card is a clickable link to the project case study.
 */

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  id: string;
  title: string;
  description: string;
  image: ImageMetadata | string;
  imageAlt: string;
  date: Date;
  tags: string[];
  status?: string;
  showTags?: boolean;
  githubUrl?: string;
  liveUrl?: string;
}

const {
  id,
  title,
  description,
  image,
  imageAlt,
  tags = [],
  showTags = true,
} = Astro.props;

const displayTags = tags.slice(0, 4);
---

<a
  href={`/projects/${id}/`}
  class="group flex flex-col rounded-3xl border border-border bg-background-card hover:border-border-hover transition-all duration-200 overflow-hidden h-full block cursor-pointer select-none shadow-sm hover:shadow-md"
  aria-label={`View project: ${title}`}
>
  {/* Top Image Preview with resting opacity that illuminates on hover */}
  <div class="relative w-full aspect-[16/10] overflow-hidden bg-background-subtle border-b border-border">
    {typeof image === "string" ? (
      <img
        src={image}
        alt={imageAlt || title}
        class="w-full h-full object-cover object-top opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Image
        src={image}
        alt={imageAlt || title}
        class="w-full h-full object-cover object-top opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
        loading="lazy"
        decoding="async"
      />
    )}
  </div>

  {/* Bottom Info Content */}
  <div class="p-6 flex flex-col justify-between flex-1 gap-4">
    <div class="space-y-2">
      <h3 class="text-lg sm:text-xl font-bold text-foreground group-hover:text-primary transition-colors duration-200 leading-snug">
        {title}
      </h3>
      <p class="text-xs sm:text-sm text-muted leading-relaxed line-clamp-2">
        {description}
      </p>
    </div>

    {showTags && displayTags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-3 border-t border-border">
        {displayTags.map((tag) => (
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-medium border border-border text-muted bg-background-subtle">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
