---
/**
 * Card de proyecto con anatomía completa.
 * Imagen, metadatos, título, descripción, tags y acciones.
 *
 * @example
 * <ProjectCard
 *   title="Mi Proyecto"
 *   description="Descripción del proyecto"
 *   image="/project.jpg"
 *   date={new Date()}
 *   tags={["React", "TypeScript"]}
 *   githubUrl="https://github.com/..."
 *   liveUrl="https://..."
 * />
 */

import { CodeSquare, Globe } from "reicon-react";
import FormattedDate from "../FormattedDate.astro";
import StatusBadge from "./StatusBadge.astro";
import Tag from "./Tag.astro";

interface Props {
  /** ID del proyecto (slug) */
  id: string;
  /** Título del proyecto */
  title: string;
  /** Descripción breve */
  description: string;
  /** Ruta de la imagen */
  image: string;
  /** Texto alternativo de la imagen */
  imageAlt: string;
  /** Fecha del proyecto */
  date: Date;
  /** Lista de tecnologías/tags */
  tags: string[];
  /** Estado del proyecto */
  status?: "en_progreso" | "completado" | "pausado";
  /** URL del repositorio de GitHub */
  githubUrl?: string;
  /** URL del proyecto en vivo */
  liveUrl?: string;
}

const {
  id,
  title,
  description,
  image,
  imageAlt,
  date,
  tags = [],
  status,
  githubUrl,
  liveUrl,
} = Astro.props;
---

<article
  class:list={[
    "group flex flex-col relative",
    "rounded-2xl border border-foreground/15",
    "p-0 overflow-hidden",
    "hover:border-foreground/30",
    "transition-all duration-300",
  ]}
>
  <!-- Enlace que cubre todo el card -->
  <a
    href={`/projects/${id}/`}
    class="absolute inset-0 z-10"
    aria-label={`Ver proyecto: ${title}`}
  >
    <span class="sr-only">Ver proyecto</span>
  </a>
  <!-- Imagen (Thumbnail) -->
  <div class="relative overflow-hidden" style="aspect-ratio: 16/9;">
    <img
      src={image}
      alt={imageAlt}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
      decoding="async"
    />
    <!-- Overlay con gradiente -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-background-surface/80 via-transparent to-transparent opacity-0 group-hover:opacity-60 transition-opacity duration-300"
    >
    </div>

    <!-- Status badge sobre la imagen -->
    {
      status && (
        <div class="absolute top-3 right-3">
          <StatusBadge status={status} size="sm" />
        </div>
      )
    }
  </div>

  <!-- Contenido -->
  <div class="flex flex-col flex-1 p-5 gap-3">
    <!-- Metadatos (Fecha) -->
    <p class="text-xs uppercase tracking-widest text-muted font-mono">
      <FormattedDate date={date} />
    </p>

    <!-- Título -->
    <h3
      class="text-2xl font-semibold text-foreground font-sans group-hover:text-primary transition-colors duration-200 leading-tight"
    >
      {title}
    </h3>

    <!-- Descripción -->
    <p class="text-sm text-muted leading-relaxed flex-1">
      {description}
    </p>

    <!-- Tags -->
    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
          {tags.map((tag) => <Tag text={tag} />)}
        </div>
      )
    }

    <!-- Acciones (z-index superior para ser clickeables) -->
    {
      (githubUrl || liveUrl) && (
        <div class="flex gap-3 pt-3 border-t border-foreground/5 relative z-20">
          {githubUrl && (
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-mono text-muted hover:text-primary transition-colors duration-200"
              aria-label="Ver en GitHub"
            >
              <CodeSquare size={14} />
              <span>código</span>
            </a>
          )}
          {liveUrl && (
            <a
              href={liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-mono text-muted hover:text-primary transition-colors duration-200"
              aria-label="Ver proyecto en vivo"
            >
              <Globe size={14} />
              <span>demo</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</article>
