---
/**
 * Encabezado de página reutilizable para secciones de listado.
 * Estilo terminal con breadcrumb y título.
 *
 * @example
 * <PageHeader
 *   breadcrumb="matias@web:~$ ls blog/"
 *   title="Blog"
 * />
 */

interface Props {
  /** Texto del breadcrumb/prompt (opcional) */
  breadcrumb?: string;
  /** Título principal de la página */
  title: string;
  /** Clases adicionales */
  class?: string;
}

const { breadcrumb, title, class: className } = Astro.props;
---

<div class:list={["py-6", className]}>
  {
    breadcrumb && (
      <p class="font-mono text-muted text-sm tracking-tight mb-1">
        {breadcrumb}
      </p>
    )
  }
  <h1 class="font-sans text-3xl font-bold text-foreground">{title}</h1>
</div>
