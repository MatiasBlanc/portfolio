---
// src/components/LatestPosts.astro
// Muestra los últimos posts del blog al estilo "cat lab/latest.log"
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";

const allPosts = await getCollection("blog");
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<section class="py-5 border-t border-foreground">
  <h3 class="text-muted mb-4 font-mono text-md tracking-tight">
    $ cat lab/latest.log
  </h3>
  <ul class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-foreground">
    {
      latestPosts.map((post) => (
        <li class="list-none">
          <a
            href={`/blog/${post.id}/`}
            class="block py-4 px-2 hover:bg-foreground/5 transition-colors duration-200 group"
          >
            <p class="font-mono text-sm mb-1">
              <span
                class:list={[
                  "font-bold",
                  post.data.status === "build"
                    ? "text-primary"
                    : "text-foreground opacity-50",
                ]}
              >
                [<FormattedDate date={post.data.pubDate} />]
              </span>{" "}
              <span class="text-muted">{post.data.status}</span>
            </p>
            <h4 class="font-bold font-sans text-lg group-hover:text-primary transition-colors duration-200">
              {post.data.title}
            </h4>
          </a>
        </li>
      ))
    }
  </ul>
</section>
