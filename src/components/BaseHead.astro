---
import "../global.css";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  /** Lista de preguntas frecuentes del post para el marcado FAQPage. */
  faq?: FaqItem[];
}

const {
  title,
  description,
  image = "/project-itf.webp",
  type = "website",
  pubDate,
  updatedDate,
  tags = [],
  author = "Matías Blanc",
  faq,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://matiasblanc.dev");
const imageURL = new URL(image, Astro.site || "https://matiasblanc.dev");

const pathname = Astro.url.pathname.replace(/\/$/, "");
const isContentDetail =
  (pathname.startsWith("/blog/") && pathname !== "/blog") ||
  (pathname.startsWith("/projects/") && pathname !== "/projects");

// Schema.org Structured Data (JSON-LD) for Search Engines & AI Agents (Perplexity, ChatGPT, Claude, Gemini)
const schemaData =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonicalURL.href,
        },
        headline: title,
        description: description,
        image: imageURL.href,
        datePublished: pubDate ? pubDate.toISOString() : undefined,
        dateModified: updatedDate
          ? updatedDate.toISOString()
          : pubDate
            ? pubDate.toISOString()
            : undefined,
        author: {
          "@type": "Person",
          name: author,
          url: "https://matiasblanc.dev",
          sameAs: [
            "https://github.com/matiasblanc",
            "https://linkedin.com/in/matiasblanc",
            "https://x.com/matiasblnc",
            "https://www.upwork.com/freelancers/~matiasblanc",
          ],
        },
        publisher: {
          "@type": "Person",
          name: "Matías Blanc",
          url: "https://matiasblanc.dev",
        },
        keywords: tags.length > 0 ? tags.join(", ") : undefined,
        inLanguage: "es",
      }
    : {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://matiasblanc.dev/#person",
            name: "Matías Blanc",
            url: "https://matiasblanc.dev",
            image: new URL("/project-itf.webp", Astro.site || "https://matiasblanc.dev").href,
            jobTitle: "Full-Stack & Web Engineer",
            description:
              "Full-Stack & Web Developer specializing in React, Next.js, TypeScript, and Python.",
            sameAs: [
              "https://github.com/matiasblanc",
              "https://linkedin.com/in/matiasblanc",
              "https://x.com/matiasblnc",
              "https://www.upwork.com/freelancers/~matiasblanc",
            ],
            knowsAbout: [
              "Web Development",
              "React",
              "Next.js",
              "TypeScript",
              "Python",
              "Astro",
              "TailwindCSS",
              "FastAPI",
              "PostgreSQL",
              "Full-Stack Development",
              "React Native",
              "Docker",
            ],
          },
          {
            "@type": "WebSite",
            "@id": "https://matiasblanc.dev/#website",
            url: "https://matiasblanc.dev",
            name: "Matías Blanc — Full-Stack & Web Engineer",
            description: description,
            publisher: {
              "@id": "https://matiasblanc.dev/#person",
            },
          },
        ],
      };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Matías Blanc — RSS Feed" href="/rss.xml" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="theme-color" content="#000000" />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:site_name" content="Matías Blanc — Full-Stack & Mobile Engineer" />

{type === "article" && pubDate && (
  <meta property="article:published_time" content={pubDate.toISOString()} />
)}
{type === "article" && updatedDate && (
  <meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{type === "article" && (
  <meta property="article:author" content="https://matiasblanc.dev" />
)}
{type === "article" && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@matiasblnc" />
<meta name="twitter:creator" content="@matiasblnc" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- Structured Data (JSON-LD) for Search Engines & AI Crawlers -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

{type === "article" && faq && faq.length > 0 && (
  <>
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map((item) => ({
          "@type": "Question",
          name: item.question,
          "acceptedAnswer": {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      })}
    />
  </>
)}

<!-- Prevenir flash de tema, fuente e idioma incorrectos -->
<script is:inline>
  (function () {
    const savedTheme = localStorage.getItem("theme") || "dark";
    document.documentElement.setAttribute("data-theme", savedTheme);

    const savedLang = localStorage.getItem("preferred_lang") === "en" ? "en" : "es";
    document.documentElement.setAttribute("data-lang", savedLang);

    const savedFont = localStorage.getItem("reader_font") || "serif";
    document.documentElement.setAttribute("data-font", savedFont);

    const savedSize = localStorage.getItem("reader_size") || "md";
    document.documentElement.setAttribute("data-size", savedSize);
  })();

  function googleTranslateElementInit() {
    if (window.google && window.google.translate) {
      new window.google.translate.TranslateElement(
        {
          pageLanguage: 'es',
          includedLanguages: 'en,es',
          autoDisplay: false
        },
        'google_translate_element'
      );
    }
  }
</script>

{isContentDetail && (
  <>
    <div id="google_translate_element" style="display:none"></div>
    <script is:inline src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" async defer></script>
  </>
)}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&display=swap"
  rel="stylesheet"
/>
