---
import type { ImageMetadata } from "astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import socials from "../data/socials.json";
import "../global.css";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  image?: string | ImageMetadata;
  imageAlt?: string;
  type?: "website" | "article";
  lang?: "es" | "en";
  pageTitle?: string;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  /** Preguntas también visibles en el artículo; no garantizan resultados enriquecidos. */
  faq?: FaqItem[];
}

const {
  title,
  description,
  image,
  imageAlt = "Matías Blanc — Desarrollo web y automatizaciones en Chile",
  type = "website",
  lang = "es",
  pageTitle = title,
  pubDate,
  updatedDate,
  tags = [],
  author = "Matías Blanc",
  faq,
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://mb.madeinchile.tech");
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalURL = new URL(pathname, siteURL);
const imageSrc = typeof image === "object" ? image.src : image || "/social-card.png";
const imageURL = new URL(imageSrc, siteURL);
const imageWidth = typeof image === "object" ? image.width : !image ? 1200 : undefined;
const imageHeight = typeof image === "object" ? image.height : !image ? 630 : undefined;
const personId = new URL("/#person", siteURL).href;
const websiteId = new URL("/#website", siteURL).href;
const pageId = `${canonicalURL.href}#webpage`;
const section = pathname.startsWith("/blog")
  ? { name: "Blog", path: "/blog" }
  : pathname.startsWith("/projects")
    ? { name: "Proyectos", path: "/projects" }
    : undefined;
const breadcrumbs = section
  ? [
      { name: "Inicio", url: siteURL.href },
      { name: section.name, url: new URL(section.path, siteURL).href },
      ...(pathname !== section.path ? [{ name: pageTitle, url: canonicalURL.href }] : []),
    ]
  : [];

// Una misma identidad de autor conecta las páginas y sus fuentes públicas.
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: author,
      url: new URL("/#about", siteURL).href,
      jobTitle: "Desarrollador full-stack y web",
      sameAs: [socials.github.url, socials.linkedin.url, socials.twitter.url, socials.upwork.url],
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteURL.href,
      name: SITE_TITLE,
      description: SITE_DESCRIPTION,
      inLanguage: "es",
      publisher: { "@id": personId },
    },
    {
      "@type": pathname === section?.path ? "CollectionPage" : "WebPage",
      "@id": pageId,
      url: canonicalURL.href,
      name: pageTitle,
      description,
      inLanguage: lang,
      isPartOf: { "@id": websiteId },
      breadcrumb: breadcrumbs.length > 0 ? { "@id": `${canonicalURL.href}#breadcrumb` } : undefined,
    },
    ...(type === "article" ? [{
      "@type": "BlogPosting",
      "@id": `${canonicalURL.href}#article`,
      mainEntityOfPage: { "@id": pageId },
      headline: pageTitle,
      description,
      image: imageURL.href,
      datePublished: pubDate?.toISOString(),
      dateModified: (updatedDate ?? pubDate)?.toISOString(),
      author: { "@id": personId, "@type": "Person", name: author, url: new URL("/#about", siteURL).href },
      publisher: { "@id": personId },
      keywords: tags.length > 0 ? tags.join(", ") : undefined,
      inLanguage: lang,
    }] : []),
    ...(breadcrumbs.length > 0 ? [{
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL.href}#breadcrumb`,
      itemListElement: breadcrumbs.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: item.url,
      })),
    }] : []),
    ...(type === "article" && faq?.length ? [{
      "@type": "FAQPage",
      mainEntity: faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    }] : []),
  ],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="Blog de Matías Blanc — RSS" href="/rss.xml" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="theme-color" content="#000000" />
<meta name="google-site-verification" content="DDbfupD8lNYUv9bYs2l4wAgB4k_V85AAh3D5zZlko4M" />
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={imageAlt} />
{imageWidth && <meta property="og:image:width" content={imageWidth} />}
{imageHeight && <meta property="og:image:height" content={imageHeight} />}
<meta property="og:locale" content={lang === "es" ? "es_CL" : "en_US"} />
<meta property="og:site_name" content={SITE_TITLE} />
{type === "article" && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{type === "article" && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{type === "article" && <meta property="article:author" content={new URL("/#about", siteURL)} />}
{type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@matiasblnc" />
<meta name="twitter:creator" content="@matiasblnc" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Escapar '<' impide que el contenido cierre prematuramente el script. -->
<script type="application/ld+json" set:html={JSON.stringify(schemaData).replace(/</g, "\\u003c")} />

<!-- Prevenir flash de tema, fuente e idioma incorrectos. -->
<script is:inline>
  (function () {
    const savedTheme = localStorage.getItem("theme") || "dark";
    document.documentElement.setAttribute("data-theme", savedTheme);
    const savedLang = localStorage.getItem("preferred_lang") === "en" ? "en" : "es";
    document.documentElement.setAttribute("data-lang", savedLang);
    const savedFont = localStorage.getItem("reader_font") || "serif";
    document.documentElement.setAttribute("data-font", savedFont);
    const savedSize = localStorage.getItem("reader_size") || "md";
    document.documentElement.setAttribute("data-size", savedSize);
  })();
</script>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400&display=swap"
  rel="stylesheet"
/>
